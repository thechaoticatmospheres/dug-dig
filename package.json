{
  "name": "dug-dig",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx tools/dev.ts",
    "dev:client": "vite --host 127.0.0.1",
    "start": "tsx src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
